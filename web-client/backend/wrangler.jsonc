{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "czatbox-tt-mobile",
  "main": "./worker.js",
  "compatibility_date": "2026-08-14",
  "assets": {
    "directory": "../public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": false
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "czatbox-tt-mobile",
      "database_id": "eb05a9b4-777a-4e0c-b5de-d3a11fbcc312"
    }
  ],
  "vars": {
    "EMAIL_FROM": "czatboxttm@icloud.com"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
