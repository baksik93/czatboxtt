{
  "name": "tiktok-live-electron",
  "version": "0.3.11",
  "private": true,
  "productName": "Czatbox TT",
  "description": "Desktopowy panel do odczytu czatu transmisji TikTok LIVE.",
  "author": "Baksik",
  "repository": {
    "type": "git",
    "url": "https://github.com/baksik93/czatboxtt.git"
  },
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "check": "node --check src/main.js",
    "pack": "electron-builder --dir --publish never",
    "dist": "electron-builder --win nsis --publish never",
    "release": "electron-builder --win nsis --publish always"
  },
  "build": {
    "appId": "pl.czatboxtt.app",
    "productName": "Czatbox TT",
    "artifactName": "Czatbox-TT-Setup-${version}.${ext}",
    "electronUpdaterCompatibility": ">=2.16",
    "releaseInfo": {
      "releaseNotesFile": "release-notes-0.3.11.md"
    },
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "baksik93",
        "repo": "czatboxtt",
        "releaseType": "release"
      }
    ],
    "files": [
      "src/**/*",
      "!src/preload.js",
      "!src/renderer/**/*",
      "!src/pic/**/*",
      "package.json",
      "release-notes-*.md",
      "RELEASE_NOTES.md",
      "!archives/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/piper/piper-tts.exe",
        "to": "piper/piper-tts.exe"
      },
      {
        "from": "resources/piper/pl_PL-jarvis_wg_glos-medium.onnx",
        "to": "piper/pl_PL-jarvis_wg_glos-medium.onnx"
      },
      {
        "from": "resources/piper/pl_PL-jarvis_wg_glos-medium.onnx.json",
        "to": "piper/pl_PL-jarvis_wg_glos-medium.onnx.json"
      }
    ],
    "win": {
      "icon": "src/assets/app-icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Czatbox TT",
      "deleteAppDataOnUninstall": false
    }
  },
  "devDependencies": {
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "overrides": {
    "form-data": "4.0.6"
  }
}
